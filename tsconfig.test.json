{
  // The tests, the jsdom harness and vite.config.ts, with the same strict settings as tsconfig.json. Node's and
  // jsdom's types come from @types/node and @types/jsdom; the main tsconfig.json keeps only the browser's.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["app/**/*.test.ts", "build/**/*.test.ts", "tests", "vite.config.ts"],
  "exclude": []
}
